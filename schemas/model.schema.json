{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/andyholst/what-llm/schemas/model.schema.json",
  "title": "what-llm model entry",
  "description": "Strict contract for one model entry produced by the HF trending crawler.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "name", "author", "parameters_b", "architecture", "pipeline_tag",
    "hf_url", "trending_score", "downloads", "quants", "hardware", "last_updated"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "name": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "parameters_b": { "type": "number", "exclusiveMinimum": 0 },
    "architecture": { "enum": ["dense", "moe"] },
    "pipeline_tag": { "type": "string", "minLength": 1 },
    "hf_url": { "type": "string", "pattern": "^https://huggingface\\.co/[^/]+/[^/]+/?$" },
    "trending_score": { "type": "number", "minimum": 0 },
    "downloads": { "type": "integer", "minimum": 0 },
    "quants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "size_gb", "estimated_vram_gb", "notes"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "size_gb": { "type": "number", "exclusiveMinimum": 0 },
          "estimated_vram_gb": { "type": "number", "exclusiveMinimum": 0 },
          "notes": { "type": "string" }
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nvidia", "amd", "macbook", "mobile"],
      "properties": {
        "nvidia": {
          "type": "object",
          "additionalProperties": false,
          "required": ["8gb", "12gb", "16gb", "24gb", "48gb"],
          "properties": {
            "8gb": { "type": "boolean" },
            "12gb": { "type": "boolean" },
            "16gb": { "type": "boolean" },
            "24gb": { "type": "boolean" },
            "48gb": { "type": "boolean" }
          }
        },
        "amd": {
          "type": "object",
          "additionalProperties": false,
          "required": ["8gb", "12gb", "16gb", "24gb"],
          "properties": {
            "8gb": { "type": "boolean" },
            "12gb": { "type": "boolean" },
            "16gb": { "type": "boolean" },
            "24gb": { "type": "boolean" }
          }
        },
        "macbook": {
          "type": "object",
          "additionalProperties": false,
          "required": ["16gb", "24gb", "32gb", "48gb_plus"],
          "properties": {
            "16gb": { "type": "boolean" },
            "24gb": { "type": "boolean" },
            "32gb": { "type": "boolean" },
            "48gb_plus": { "type": "boolean" }
          }
        },
        "mobile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["practical", "note"],
          "properties": {
            "practical": { "type": "boolean" },
            "note": { "type": "string" }
          }
        }
      }
    },
    "last_updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
  }
}
